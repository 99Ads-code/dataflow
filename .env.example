# Copie este arquivo para ".env" e ajuste.

# ID do cliente OAuth (Google Cloud > Credenciais). Obrigatório para o login com Google.
GOOGLE_CLIENT_ID=

# Planilha do Google (ID entre /d/ e /edit na URL) onde ficam a aba Usuarios e a de pedidos
SPREADSHEET_ID=1_fpbcB6q1dRcCvAdjqeLJY1s3rsdBMFTcTvOxvB_j64

# Aba onde os pedidos são lidos e gravados (estrutura da planilha "99 Ads Tag Request")
ABA_PEDIDOS=99 Ads Tag Request

HOST=127.0.0.1
PORT=3737
